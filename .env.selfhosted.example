# ============================================
# Environment Variables - SELF-HOSTED VERSION
# ============================================
# Copy this to .env and fill in your values
# cp .env.selfhosted.example .env

# ========== DATABASE ==========
DB_USER=flower_user
DB_PASSWORD=your_secure_password_here
DB_NAME=flower_marketplace
DATABASE_URL=postgresql://flower_user:your_secure_password_here@postgres:5432/flower_marketplace

# ========== JWT ==========
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# ========== SERVER ==========
NODE_ENV=production
PORT=5000
